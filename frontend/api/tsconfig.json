{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "./dist",
		"rootDir": ".",
		"types": ["node"],
		"jsx": "react-jsx"
	},
	"include": ["./**/*.ts", "./**/*.tsx"],
	"exclude": ["node_modules"]
}
