# Database 설정 (Neon DB)
DATABASE_URL=postgresql://username:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Supabase 설정 (마이그레이션 중 - 곧 제거 예정)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Google Cloud Vision API (견적서 이미지 OCR용)
GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key

# OpenAI GPT-5 API (견적 분석 및 이미지 파싱용)
OPENAI_API_KEY=your-openai-api-key

# 서버 설정
PORT=3001
NODE_ENV=development

# CORS 설정
FRONTEND_URL=http://localhost:5173

ADMIN_PASSWORD=your_admin_password_here

# JWT 인증 설정
# 랜덤한 문자열로 설정하세요 (예: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here

# Slack notifications (optional)
ENABLE_SLACK_NOTIFICATIONS=false
# Dev webhook (set only if Slack integration is enabled)
SLACK_DEV_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/DEV/WEBHOOK

# Admin webhook (set only if Slack integration is enabled)
SLACK_ADMIN_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/ADMIN/WEBHOOK

# Notion 개발 로그 설정
# Notion 통합 API 키 (https://www.notion.so/my-integrations 에서 발급)
NOTION_API_KEY=your_notion_api_key_here
# 로그를 저장할 Notion 데이터베이스 ID
NOTION_DATABASE_ID=your_notion_database_id_here
NOTION_CUSTOMER_REQUEST_DB_ID=your_notion_customer_request_db_id_here

# Google Service Account (GA4, Gmail, Search Console)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=your-project-id
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=../your-service-account-key.json

# Google Analytics 4
GA4_PROPERTY_ID=your-ga4-property-id

# Gmail API
GMAIL_SENDER_EMAIL=your-email@domain.com

# Google Search Console
SEARCH_CONSOLE_SITE_URL=https://your-domain.com

# Airtable (Analytics 동기화)
AIRTABLE_API_KEY=your-airtable-personal-access-token
AIRTABLE_BASE_ID=your-airtable-base-id

# Naver OAuth configuration
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_CALLBACK_URL=https://your-frontend-domain/auth/naver/callback
